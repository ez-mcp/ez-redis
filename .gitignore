.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# uv artifacts (uv.lock is committed, never ignored)

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
