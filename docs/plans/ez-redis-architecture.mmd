%%
%% Rules of this file:
%%   1. Every node id is owned by ≥1 plan phase (shown as "(Pnn)" in the label).
%%   2. Any PR that adds, removes, or re-wires a component edits THIS file first
%%      and cites the node ids in its description.
%%   3. Dashed "seam" nodes are documented extension points only — no code exists for them in v1 (D27).
%%   4. Grey nodes are external to the package.
%%
%% Validated with the Mermaid validator on 2026-09-01.

flowchart TB

  subgraph HOST["Agent host — Claude Code / VS Code (D32)"]
    direction TB
    USER[Developer prompt]
    AGENT[LLM agent]
    EVT["Hook events<br/>UserPromptSubmit · PreToolUse · SessionStart"]
  end

  subgraph PKG["ez-redis package — PyPI · uvx · Python ≥3.11 · MIT (P1, P45)"]
    direction TB

    subgraph ENTRY["Entry points"]
      direction LR
      SERVER["server.py<br/>MCPServer · stdio · mcp v2 (P7)"]
      HOOK["hook.py<br/>python -m ez_redis.hook (P34–P36)"]
      CLI["cli.py<br/>init · doctor · --version (P44)"]
    end

    subgraph TOOLS["tools/ — exactly four handlers"]
      direction LR
      T_SEARCH["search_redis (P12)"]
      T_OPT["optimize_redis<br/>command · snippet · repo (P29)"]
      T_ARCH["redis_architecture<br/>needs_input ↔ complete (P41)"]
      T_CONV["redis_conversion<br/>consent-guarded (P43)"]
    end

    DUAL["Dual output helper<br/>structuredContent + markdown · isError mapping (P7)"]

    subgraph HOOKPACK["Hook pack (Track G)"]
      direction TB
      HOSTS["hosts/ claude · vscode<br/>field-shape detection → HookEvent (P32)"]
      GATE["Gate disk cache<br/>XDG_CACHE_HOME/ez-redis (P33)"]
      H_PROMPT["Prompt path<br/>gate a+b → search_redis → facts ≤600 (P34)"]
      H_EDIT["Edit path<br/>.py + redis term → snippet optimize → hook_eligible only (P35)"]
      HOOKCFG["hooks/ claude + vscode JSON<br/>+ SessionStart warmer (P36)"]
    end

    subgraph ENGINE["engine/ — pure library (§7.1, D27)"]
      direction TB
      DISC["discover.py<br/>rg --json · argv-only · caps (P8)"]
      TERMS["terms.py<br/>Redis term catalog (P9)"]
      MANIF["manifests.py<br/>dependency detector (P9)"]
      SCORE["scoring.py<br/>deterministic 1–10 (P10)"]
      LRU["In-process LRU<br/>fingerprint + 10-min TTL (P11)"]
      PARSE["parse_py.py<br/>ast → facts (P14–P16)"]
      IR["ir.py<br/>RedisCall · ClientConstruction · DatastoreWrite · FileFacts (P13)"]
      CLIPARSE["cli_command.py<br/>strict redis-cli tokenizer (P26)"]
      subgraph RULES["rules/ registry (P17)"]
        direction LR
        R_SCAN["EZR001–004<br/>full scan (P18–P19)"]
        R_PIPE["EZR010<br/>loop → pipeline (P20)"]
        R_TTL["EZR020–021<br/>TTL hygiene (P21)"]
        R_CONN["EZR030–031<br/>connection (P22)"]
        R_DESTR["EZR040<br/>destructive (P23)"]
        R_CA["EZR050<br/>cache-aside order (P24)"]
      end
      POLICY["policy.py<br/>severity × confidence · filters · hook_eligible (P27)"]
      RENDER["render.py<br/>diff · rationale · doc_refs · markdown (P28)"]
      SEAM1["(v2 seam, prose only)<br/>other-language Parser"]:::seam
      SEAM2["(v2 seam, prose only)<br/>dynamic EvidenceSource"]:::seam
    end

    subgraph ARCH["architecture/ (Track H)"]
      direction LR
      QBANK["questions.py<br/>8 mandatory + conditional · ≤3 rounds (P38)"]
      PLANNER["planner.py<br/>pattern · keys · TTL · capacity · checklist (P39)"]
      MERMAID["mermaid.py<br/>3–5 diagrams + minimal validator (P40)"]
    end
    DETECT["conversion/detectors.py<br/>EZC001–006 (P42)"]

    subgraph KNOW["knowledge/ (Track F)"]
      direction LR
      KB["kb.py loader (P31)"]
      KBDATA["data/ patterns · rules_docs · checklist · security (P30)"]
      CMDTAB["data/commands.json<br/>built at dev time (P25)"]
    end

    SAFE["safety.py<br/>path confine · secret denylist · redaction · caps (P4)"]
    TYPES["types.py (P5)"]
    SCHEMAS["schemas.py<br/>Pydantic v2 I/O · extra=forbid (P6)"]
    LOG["logging.py<br/>JSON lines → stderr (P1)"]
  end

  RG["ripgrep binary (required)"]
  REPO[("User repository<br/>read-only")]
  XDG[("XDG_CACHE_HOME/ez-redis")]

  subgraph DEV["Dev & quality (not shipped)"]
    direction LR
    TESTS["tests/ unit · golden · fixtures · hooks (P3)"]
    BENCH["tests/bench 10k fixture · p95 under 300ms (P37)"]
    CI["GitHub Actions<br/>ruff · pyright · pytest · pip-audit · Inspector · bench (P2, P37, P45)"]
    DOCS["README · CONTRIBUTING · docs/rules.md (auto) · docs/hooks.md (P36, P45)"]
  end

  %% Host ↔ package
  USER --> AGENT
  USER --> EVT
  AGENT -- "tools/call" --> SERVER
  EVT -- "stdin JSON" --> HOOK
  HOOK -- "additionalContext only<br/>(never permissionDecision / updatedInput)" --> AGENT
  SERVER --> T_SEARCH & T_OPT & T_ARCH & T_CONV
  T_SEARCH & T_OPT & T_ARCH & T_CONV --> DUAL
  DUAL --> SERVER

  %% Hook internals
  HOOK --> HOSTS --> H_PROMPT & H_EDIT
  H_PROMPT --> GATE
  GATE <--> XDG
  GATE --> MANIF
  H_PROMPT --> T_SEARCH
  H_EDIT --> T_OPT
  HOOKCFG -. installed by .-> CLI

  %% Tools → engine
  T_SEARCH --> DISC & SCORE & LRU
  SCORE --> TERMS & MANIF
  T_OPT --> CLIPARSE & PARSE & POLICY & RENDER
  T_OPT -- "repo mode" --> T_SEARCH
  CLIPARSE --> CMDTAB
  CLIPARSE --> IR
  PARSE --> IR
  IR --> RULES
  RULES --> POLICY --> RENDER
  RENDER --> KB
  SEAM1 -.-> IR
  SEAM2 -.-> IR

  %% Architecture & conversion
  T_ARCH --> QBANK --> PLANNER --> MERMAID
  PLANNER --> KB
  T_ARCH -- "repo pre-fill" --> T_SEARCH & PARSE
  T_CONV --> DETECT --> IR
  T_CONV -- "delegates" --> T_ARCH

  %% Knowledge
  KB --> KBDATA

  %% Cross-cutting
  SERVER --> SCHEMAS
  HOOK --> SCHEMAS
  SCHEMAS --> TYPES
  RULES --> TYPES
  DISC --> SAFE
  PARSE --> SAFE
  DETECT --> SAFE
  SERVER --> LOG
  HOOK --> LOG
  CLI --> LOG

  %% External
  DISC -- "subprocess argv, shell=False" --> RG
  RG --> REPO
  DISC -- "bounded reads" --> REPO
  PARSE -- "bounded reads" --> REPO
  CLI -- "init: writes hook config<br/>after printing (D33)" --> REPO

  %% Dev
  TESTS -.-> ENGINE
  BENCH -.-> HOOK
  CI -.-> TESTS & BENCH
  DOCS -.-> RULES

  classDef seam fill:none,stroke-dasharray: 4 4,stroke:#888,color:#888
  classDef ext fill:#f4f4f4,stroke:#999
  class RG,REPO,XDG ext
